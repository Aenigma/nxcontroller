# Copy to firmware/.env (gitignored; `mise run setup` does). Read by `mise run build:esp32s3`, `flash`
# and `build:pico`; never by the web page's firmware.
# WiFi is optional: without it (or if it fails) the board opens the
# "nxcontroller-setup" hotspot. WiFi saved on the board always wins over these.
WIFI_SSID="your-network"
WIFI_PASSWORD="your-password"
# Name reported by discovery / HELLO (max 32 chars)
NXC_NAME="nxcontroller"
